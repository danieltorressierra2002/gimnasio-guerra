rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return exists(/databases/$(database)/documents/perfiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/perfiles/$(request.auth.uid)).data.rol == "admin";
    }

    match /perfiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && esAdmin();
    }

    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read, write: if request.auth != null && esAdmin();
    }

    // Productos: público puede leer, solo admin escribe
    match /productos/{productoId} {
      allow read: if true;
      allow write: if request.auth != null && esAdmin();
    }

    // Ofertas flash: público puede leer, solo admin escribe
    match /ofertasFlash/{ofertaId} {
      allow read: if true;
      allow write: if request.auth != null && esAdmin();
    }
  }
}
